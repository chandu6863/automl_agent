# Copy this file to backend/.env and fill in real values for local dev.
# NEVER commit a real .env file.

ENV=development
DEBUG=true

# Postgres in docker-compose; SQLite fallback is used automatically if unset in local dev.
DATABASE_URL=postgresql://automl_user:automl_pass@localhost:5432/automl_db

JWT_SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

DATASET_STORAGE_DIR=./storage/datasets
MAX_UPLOAD_SIZE_MB=200

# Fill these after starting Hardhat and running `npm run deploy:local` in /blockchain.
CHAIN_RPC_URL=http://127.0.0.1:8545
DATASET_REGISTRY_CONTRACT_ADDRESS=
CHAIN_DEPLOYER_PRIVATE_KEY=
